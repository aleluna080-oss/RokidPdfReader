<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- BIBLIOTECA -->
    <LinearLayout
        android:id="@+id/libraryView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ROKID PDF READER"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="19sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/libraryHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Recibe un PDF desde tu teléfono o impórtalo localmente."
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:gravity="center" />

        <Button
            android:id="@+id/receiveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="RECIBIR PDF DESDE TELÉFONO" />

        <Button
            android:id="@+id/importButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="IMPORTAR PDF LOCAL" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/documentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- TRANSFERENCIA QR -->
    <LinearLayout
        android:id="@+id/transferView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp"
        android:visibility="gone"
        android:background="#000000">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ENVIAR PDF A LAS ROKID"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="1. Conecta teléfono y Rokid a la misma Wi‑Fi.&#10;2. Escanea este QR con el teléfono.&#10;3. Elige el PDF y pulsa SUBIR."
            android:textColor="#D9FFFFFF"
            android:textSize="12sp"
            android:gravity="center" />

        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginTop="10dp"
            android:contentDescription="Código QR para enviar PDF"
            android:adjustViewBounds="true"
            android:background="#FFFFFF" />

        <TextView
            android:id="@+id/transferUrlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="http://192.168.1.10:8787/"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/transferStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Esperando conexión…"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:gravity="center" />

        <Button
            android:id="@+id/closeTransferButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="VOLVER A BIBLIOTECA" />
    </LinearLayout>

    <!-- VISOR -->
    <LinearLayout
        android:id="@+id/viewerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <Button
                android:id="@+id/backToLibraryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←" />

            <TextView
                android:id="@+id/fileNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:gravity="center"
                android:text="Documento.pdf"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 / 1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/gestureStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gestos: preparados"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp"
                android:ellipsize="end"
                android:maxLines="2" />

            <Button
                android:id="@+id/gestureToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="GESTOS ON"
                android:textSize="10sp" />
        </LinearLayout>

        <com.alexluna.rokidpdfreader.ZoomImageView
            android:id="@+id/pdfImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"
            android:contentDescription="Página PDF" />

        <TextView
            android:id="@+id/gestureHelpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="✋ desliza: página  ·  🤏 mueve: desplazar  ·  👐 separa/junta: zoom  ·  👍 ajustar  ·  ✊ mantener: biblioteca"
            android:textColor="#AFFFFFFF"
            android:textSize="9sp"
            android:gravity="center" />

        <!-- Controles físicos/táctiles de respaldo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="4dp">

            <Button
                android:id="@+id/prevButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ANT."
                android:textSize="10sp" />

            <Button
                android:id="@+id/zoomOutButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="−" />

            <Button
                android:id="@+id/fitButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AJUSTAR"
                android:textSize="9sp" />

            <Button
                android:id="@+id/zoomInButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+" />

            <Button
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SIG."
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
